# Azure Maps shared key (Azure Portal > your Azure Maps account > Authentication > Shared Key)
# Required. The server refuses to start without it.
AZURE_MAPS_KEY=

# Port the Express server listens on locally.
PORT=3000

# Base URL for the Azure Maps REST APIs.
AZURE_MAPS_BASE_URL=https://atlas.microsoft.com

# Timeout (ms) applied to each outbound Azure Maps call.
AZURE_MAPS_TIMEOUT_MS=8000
