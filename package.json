{
  "name": "weather-demo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js backend that resolves supported cities and fetches current weather via Azure Maps.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "vitest run tests/backend",
    "test:frontend": "vitest run tests/frontend"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0-rc.1"
  }
}
